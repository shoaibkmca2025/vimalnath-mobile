{
  "name": "vimalnath-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "import-data": "node --env-file-if-exists=.env src/import-data.ts",
    "owner-link": "node --env-file-if-exists=.env src/staff.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17",
    "postgres": "^4.1.0",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3"
  }
}
