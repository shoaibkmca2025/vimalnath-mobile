# Copy to .env for local work. On the live server these come from the host's secret settings.
NODE_ENV=development
PORT=3000
# Matches docker-compose.yml, which is for this computer only.
DATABASE_URL=postgres://vimalnath:local-only@127.0.0.1:5433/vimalnath
# The one web address allowed to call the admin API from a browser.
ADMIN_ORIGIN=http://localhost:5180
# true only when the host puts a proxy in front of this server.
TRUST_PROXY=false
