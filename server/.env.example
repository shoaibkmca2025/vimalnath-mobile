# Copy to .env for local work. On the live server these come from the host's secret settings.
NODE_ENV=development
PORT=3000
# Matches docker-compose.yml, which is for this computer only.
DATABASE_URL=postgres://vimalnath:local-only@127.0.0.1:5433/vimalnath
# The one web address allowed to call the admin API from a browser.
ADMIN_ORIGIN=http://localhost:5180
# true only when the host puts a proxy in front of this server.
TRUST_PROXY=false

# Module 10, notifications. Leave these out and new-order emails are logged as "not set up".
# Any SMTP login, e.g. Gmail with an app password: smtps://you%40gmail.com:app-password@smtp.gmail.com
# SMTP_URL=
# Who the emails are from; defaults to the SMTP login.
# MAIL_FROM=Vimalnath Orders <orders@vimalnath.in>
# Only if "enhanced push security" is switched on in the Expo dashboard.
# EXPO_ACCESS_TOKEN=

# Only on a host anyone can reach (Render free): the secret the admin's Cloudflare Worker sends with every /v1 call.
# The API then refuses calls without it and trusts the visitor address the Worker passes on. At least 32 characters.
# PROXY_SECRET=
# Android push (Firebase Cloud Messaging). In the Firebase console: Project settings → Service accounts → Generate new
# private key. Paste the whole JSON on one line, or base64 of it. Keep it only here and in the hosting's secrets.
# FCM_SERVICE_ACCOUNT=
