// The admin, with /v1 passed to the API on Render: `npm run deploy:admin` from this folder. Free plan.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vimalnath-admin",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../admin/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*"]
  },
  "vars": { "API_ORIGIN": "https://vimalnath-api.onrender.com" },
  // An earlier Containers attempt registered an `Api` Durable Object class (it never ran or stored anything); v2 removes it.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Api"] },
    { "tag": "v2", "deleted_classes": ["Api"] }
  ],
  "observability": { "enabled": true }
}
